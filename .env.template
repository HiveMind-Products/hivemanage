ADMIN_PASSWORD=password
DSN=postgres://postgres:root@localhost:5432/fivemanage-lite-dev?sslmode=disable

API_TOKEN_HMAC_SECRET=<32 bytes secret>

S3_PROVIDER=minio # minio, r2, s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_ENDPOINT=http://localhost:9000
AWS_BUCKET=lite-dev
AWS_REGION=eu-west-1
# Public CDN base URL for served files. Used as the V3 API "url" field; the V3
# "originalUrl" is derived from AWS_ENDPOINT/AWS_BUCKET. Leave blank to fall back
# to the default storage URL (or a signed URL for private buckets).
BUCKET_DOMAIN=http://localhost:9000/lite-dev

CLICKHOUSE_HOST=localhost:19000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=password

VERSION=dev # dev only
ENV=dev # dev only

# Base URL (scheme://host) used to build presigned upload links. When set, it is
# used instead of the request Host header, preventing Host-header poisoning of
# generated URLs. Recommended in production.
PUBLIC_BASE_URL=

# Swagger UI/spec is served only when ENV=dev. Set to true to force-enable it in
# other environments (exposes the full API surface — leave unset in production).
SWAGGER_ENABLED=

ALLOWED_ORIGINS=http://localhost:8080

# NOTE: The credentials above (ADMIN_PASSWORD, DSN password, AWS/MinIO keys,
# CLICKHOUSE_PASSWORD) are DEV DEFAULTS ONLY. When ENV is not "dev" the app
# refuses to start if any of them is left at its default/placeholder value.
